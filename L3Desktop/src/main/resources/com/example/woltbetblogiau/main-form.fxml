                            </children></AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="chatTab" onSelectionChanged="#reloadTableData" text="Chat management">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <ListView fx:id="allChats" layoutX="14.0" layoutY="21.0" onMouseClicked="#loadChatMessages" prefHeight="409.0" prefWidth="207.0">
                                    <contextMenu>
                                        <ContextMenu>
                                            <items>
                                                <MenuItem mnemonicParsing="false" onAction="#deleteChat" text="Delete chat" />
                                            </items>
                                        </ContextMenu>
                                    </contextMenu>
                                </ListView>
                                <ListView fx:id="chatMessages" layoutX="238.0" layoutY="22.0" prefHeight="290.0" prefWidth="435.0">
                                    <contextMenu>
                                        <ContextMenu>
                                            <items>
                                                <MenuItem mnemonicParsing="false" onAction="#deleteMessage" text="Delete message" />
                                            </items>
                                        </ContextMenu>
                                    </contextMenu>
                                </ListView>
                        <TextArea fx:id="chatMessageBody" layoutX="238.0" layoutY="332.0" prefHeight="85.0" prefWidth="433.0" promptText="type a reply..." />
