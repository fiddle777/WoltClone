                        <Button fx:id="deleteMessage" layoutX="703.0" layoutY="349.0" mnemonicParsing="false" onAction="#deleteMessage" text="Delete Message" />
                        <Button fx:id="logoutButton" layoutX="753.0" layoutY="23.0" mnemonicParsing="false" onAction="#logout" text="Log out" />
