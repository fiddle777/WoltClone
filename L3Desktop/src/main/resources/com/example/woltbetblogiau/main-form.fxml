                                <ComboBox fx:id="filterStatus" layoutX="14.0" layoutY="21.0" onAction="#filterOrders" prefWidth="150.0" promptText="Filder Order Status" />
                                <ComboBox fx:id="filterClients" layoutX="173.0" layoutY="21.0" onAction="#filterOrders" prefWidth="150.0" promptText="Filter Clients" />
                                <ListView fx:id="foodList" layoutX="412.0" layoutY="74.0" prefHeight="360.0" prefWidth="220.0" AnchorPane.leftAnchor="412.0" AnchorPane.rightAnchor="191.0" />
