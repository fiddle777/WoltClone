                                        <TableColumn fx:id="nameCol" prefWidth="75.0" text="Name" />
                                        <TableColumn fx:id="surnameCol" prefWidth="75.0" text="Surname" />
                                        <TableColumn fx:id="addrCol" prefWidth="54.39996337890625" text="Address" />
                                        <TableColumn fx:id="dummyCol" prefWidth="96.00006103515625" text="Action" />
                                    </columns>
                                </TableView>
                                <Button layoutX="626.0" layoutY="303.0" mnemonicParsing="false" onAction="#loadUser" text="Update User" />
                                <Button layoutX="621.0" layoutY="258.0" mnemonicParsing="false" onAction="#addUser" text="Add new user" />
                                <Button layoutX="628.0" layoutY="349.0" mnemonicParsing="false" onAction="#deleteUser" text="Delete User" />
                        <ComboBox fx:id="userSearchTypeCombo" layoutX="621.0" layoutY="35.0" prefWidth="150.0" promptText="SearchType" />
