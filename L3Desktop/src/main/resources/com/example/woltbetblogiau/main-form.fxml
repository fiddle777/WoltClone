                                <TextArea fx:id="ingredientsField" layoutX="236.0" layoutY="74.0" prefHeight="150.0" prefWidth="200.0" promptText="Ingredients" />
                                <ListView fx:id="restaurantList" layoutX="236.0" layoutY="233.0" onMouseClicked="#loadRestaurantMenu" prefHeight="92.0" prefWidth="200.0" />
