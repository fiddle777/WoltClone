                                <TableView fx:id="userTable" layoutX="1.0" layoutY="6.0" prefHeight="430.0" prefWidth="594.0">
                                    <columns>
                                        <TableColumn fx:id="idCol" prefWidth="56.79998779296875" text="Id" />
