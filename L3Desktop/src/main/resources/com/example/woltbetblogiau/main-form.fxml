                        <Button fx:id="clearUserSearchButton" layoutX="728.0" layoutY="116.0" mnemonicParsing="false" onAction="#clearUserSearch" text="Clear" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="managementTab" onSelectionChanged="#reloadTableData" text="Order management">
