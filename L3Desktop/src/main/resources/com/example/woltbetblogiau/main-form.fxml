<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="470.0" prefWidth="823.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.woltbetblogiau.fxControllers.MainForm">
    <children>
        <TabPane fx:id="tabsPane" prefHeight="401.0" prefWidth="601.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <tabs>
                <Tab fx:id="userTab" onSelectionChanged="#reloadTableData" text="User management">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <TableView fx:id="userTable" layoutX="1.0" layoutY="6.0" prefHeight="180.0" prefWidth="594.0">
                                    <columns>
                                        <TableColumn fx:id="idCol" prefWidth="56.79998779296875" text="Id" />
                                        <TableColumn fx:id="userTypeCol" prefWidth="69.60003662109375" text="User type" />
                                        <TableColumn fx:id="loginCol" prefWidth="75.20001220703125" text="Login" />
                                        <TableColumn fx:id="passCol" prefWidth="100.0" text="Password" />
                                        <TableColumn fx:id="nameCol" prefWidth="75.0" text="Name" />
                                        <TableColumn fx:id="surnameCol" prefWidth="75.0" text="Surname" />
                                        <TableColumn fx:id="addrCol" prefWidth="54.39996337890625" text="Address" />
                                        <TableColumn fx:id="dummyCol" prefWidth="96.00006103515625" text="Action" />
                                    </columns>
                                </TableView>
                                <Button layoutX="228.0" layoutY="245.0" mnemonicParsing="false" onAction="#loadUser" text="Update User" />
                                <Button layoutX="106.0" layoutY="245.0" mnemonicParsing="false" onAction="#addUser" text="Add new user" />
                                <Button layoutX="334.0" layoutY="245.0" mnemonicParsing="false" onAction="#deleteUser" text="Delete User" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="managementTab" onSelectionChanged="#reloadTableData" text="Order management">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <ListView fx:id="ordersList" layoutX="14.0" layoutY="65.0" onMouseClicked="#loadOrderInfo" prefHeight="288.0" prefWidth="201.0">
                                    <contextMenu>
                                        <ContextMenu>
                                            <items>
                                                <MenuItem mnemonicParsing="false" onAction="#deleteOrder" text="Delete" />
                                            </items>
                                        </ContextMenu>
                                    </contextMenu></ListView>
                                <Button layoutX="248.0" layoutY="320.0" mnemonicParsing="false" onAction="#createOrder" text="New" />
                                <Button layoutX="371.0" layoutY="320.0" mnemonicParsing="false" onAction="#updateOrder" text="Update" />
                                <Button layoutX="504.0" layoutY="320.0" mnemonicParsing="false" onAction="#deleteOrder" text="Delete" />
                                <TextField fx:id="titleField" layoutX="649.0" layoutY="106.0" promptText="Order Name" />
                                <ComboBox fx:id="clientList" layoutX="648.0" layoutY="67.0" prefWidth="150.0" promptText="Select Client" />
                                <TextField fx:id="priceField" layoutX="649.0" layoutY="143.0" promptText="Order Price" />
                                <ComboBox fx:id="restaurantField" layoutX="649.0" layoutY="186.0" onAction="#loadRestaurantMenuForOrder" prefWidth="150.0" promptText="Restaurant" />
                                <ListView fx:id="basicUserList" layoutX="220.0" layoutY="65.0" prefHeight="203.0" prefWidth="192.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="411.0" />
                                <ComboBox fx:id="orderStatusField" layoutX="605.0" layoutY="438.0" prefWidth="150.0" promptText="Order Status" />
                                <ComboBox fx:id="filterStatus" layoutX="14.0" layoutY="21.0" onAction="#filterOrders" prefWidth="150.0" promptText="Filder Order Status" />
                                <ComboBox fx:id="filterClients" layoutX="173.0" layoutY="21.0" onAction="#filterOrders" prefWidth="150.0" promptText="Filter Clients" />
                                <ListView fx:id="foodList" layoutX="417.0" layoutY="67.0" prefHeight="200.0" prefWidth="220.0" AnchorPane.leftAnchor="417.0" AnchorPane.rightAnchor="186.0" />
                                <Button layoutX="649.0" layoutY="242.0" mnemonicParsing="false" onAction="#loadChatForm" text="View chat" />
                        <DatePicker fx:id="dateFilterFrom" layoutX="498.0" layoutY="21.0" prefHeight="25.0" prefWidth="150.0" />
                        <DatePicker fx:id="DateFilterTo" layoutX="660.0" layoutY="21.0" prefHeight="25.0" prefWidth="154.0" />
                        <ComboBox fx:id="filterRestaurants" layoutX="337.0" layoutY="21.0" onAction="#filterOrders" prefWidth="150.0" promptText="Filter Restaurants" />
                            </children></AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="foodTab" onSelectionChanged="#reloadTableData" text="Food management">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <ListView fx:id="cuisineList" layoutX="14.0" layoutY="33.0" prefHeight="327.0" prefWidth="203.0">
                                    <contextMenu>
                                        <ContextMenu>
                                            <items>
                                                <MenuItem mnemonicParsing="false" text="Delete" />
                                            </items>
                                        </ContextMenu>
                                    </contextMenu></ListView>
                                <Label layoutX="14.0" layoutY="14.0" text="Menu:" />
                                <TextField fx:id="titleCuisineField" layoutX="236.0" layoutY="33.0" prefHeight="25.0" prefWidth="200.0" promptText="Title" />
                                <TextArea fx:id="ingredientsField" layoutX="236.0" layoutY="74.0" prefHeight="150.0" prefWidth="200.0" promptText="Ingredients" />
                                <ListView fx:id="restaurantList" layoutX="236.0" layoutY="233.0" onMouseClicked="#loadRestaurantMenu" prefHeight="92.0" prefWidth="200.0" />
                                <Button layoutX="236.0" layoutY="332.0" mnemonicParsing="false" onAction="#createNewMenuItem" text="New" />
                                <Button layoutX="365.0" layoutY="332.0" mnemonicParsing="false" onAction="#updateMenuItem" text="Update" />
                                <TextField fx:id="cuisinePriceField" layoutX="445.0" layoutY="33.0" promptText="Price" />
                                <CheckBox fx:id="isDeadly" layoutX="445.0" layoutY="74.0" mnemonicParsing="false" text="Spicy" />
                                <CheckBox fx:id="isVegan" layoutX="445.0" layoutY="107.0" mnemonicParsing="false" text="Vegan" />
                        <Button layoutX="296.0" layoutY="332.0" mnemonicParsing="false" onAction="#deleteCuisine" text="Delete" />
                            </children></AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="chatTab" onSelectionChanged="#reloadTableData" text="Chat management">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <ListView fx:id="allChats" layoutX="14.0" layoutY="21.0" onMouseClicked="#loadChatMessages" prefHeight="409.0" prefWidth="207.0">
                                    <contextMenu>
                                        <ContextMenu>
                                            <items>
                                                <MenuItem mnemonicParsing="false" onAction="#deleteChat" text="Delete chat" />
                                            </items>
                                        </ContextMenu>
                                    </contextMenu>
                                </ListView>
                                <ListView fx:id="chatMessages" layoutX="238.0" layoutY="22.0" prefHeight="407.0" prefWidth="185.0">
                                    <contextMenu>
                                        <ContextMenu>
                                            <items>
                                                <MenuItem mnemonicParsing="false" onAction="#deleteMessage" text="Delete message" />
                                            </items>
                                        </ContextMenu>
                                    </contextMenu>
                                </ListView>
                        <TextArea fx:id="chatMessageBody" layoutX="443.0" layoutY="33.0" prefHeight="200.0" prefWidth="185.0" promptText="type a reply..." />
                        <Button fx:id="sendChatMessage" layoutX="443.0" layoutY="253.0" mnemonicParsing="false" onAction="#sendChatMessage" prefHeight="25.0" prefWidth="101.0" text="Send message" />
                        <Button fx:id="deleteChat" layoutX="443.0" layoutY="328.0" mnemonicParsing="false" onAction="#deleteChat" prefHeight="25.0" prefWidth="101.0" text="Delete chat" />
                        <Button fx:id="deleteMessage" layoutX="443.0" layoutY="290.0" mnemonicParsing="false" onAction="#deleteMessage" text="Delete Message" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
