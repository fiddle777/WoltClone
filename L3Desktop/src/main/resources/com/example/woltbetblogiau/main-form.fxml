                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <ListView fx:id="ordersList" layoutX="15.0" layoutY="62.0" onMouseClicked="#loadOrderInfo" prefHeight="220.0" prefWidth="388.0">
