                        <Text layoutX="412.0" layoutY="72.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Food" />
                            </children></AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="foodTab" onSelectionChanged="#reloadTableData" text="Food management">
                    <content>
